name = "mizchi/bit_io_native"

version = "0.48.1"

import {
  "mizchi/bit_core@0.48.1",
  "mizchi/bit_io@0.48.1",
  "mizchi/bit_object@0.48.1",
  "mizchi/bit_objstore@0.48.1",
  "mizchi/bit_pack@0.48.1",
  "mizchi/bit_protocol@0.48.1",
  "mizchi/bit_repo@0.48.1",
  "mizchi/bit_types@0.48.1",
  "moonbitlang/async@0.22.5",
  "moonbitlang/x@0.5.6",
}

readme = "README.mbt.md"

repository = "https://github.com/mizchi/bit-vcs"

license = "Apache-2.0"

keywords = [ "git", "io", "native" ]

description = "Native HTTP, process, and worktree adapters for bit"

source = "src"

preferred_target = "native"
