name = "mizchi/bit_protocol"

version = "0.49.1"

import {
  "mizchi/bit_core@0.49.1",
  "mizchi/bit_object@0.49.1",
  "mizchi/bit_io@0.49.1",
  "mizchi/bit_repo@0.49.1",
  "mizchi/bit_types@0.49.1",
  "mizchi/bit_pack@0.49.1",
  "moonbitlang/async@0.22.5",
}

repository = "https://github.com/mizchi/bit-vcs"

license = "Apache-2.0"

keywords = [ "git", "protocol", "transport" ]

description = "Git wire protocol + transport (gix-protocol + gix-transport)"

source = "src"

preferred_target = "native"
