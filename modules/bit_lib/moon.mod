  "mizchi/bit_io_native@0.49.0",
  "mizchi/bit_object@0.49.0",
  "mizchi/bit_osfs@0.49.0",
  "mizchi/bit_pack@0.49.0",
  "mizchi/bit_protocol@0.49.0",
  "mizchi/bit_refs@0.49.0",
  "mizchi/bit_reftable@0.49.0",
  "mizchi/bit_remote@0.49.0",
  "mizchi/bit_repo@0.49.0",
