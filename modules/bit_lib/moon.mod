  "mizchi/bit_hash@0.50.0",
  "mizchi/bit_ignore@0.50.0",
  "mizchi/bit_io@0.50.0",
  "mizchi/bit_io_native@0.50.0",
  "mizchi/bit_object@0.50.0",
  "mizchi/bit_osfs@0.50.0",
  "mizchi/bit_pack@0.50.0",
  "mizchi/bit_protocol@0.50.0",
  "mizchi/bit_refs@0.50.0",
  "mizchi/bit_reftable@0.50.0",
  "mizchi/bit_remote@0.50.0",
