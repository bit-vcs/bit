name = "mizchi/bit_vfs"

version = "0.50.0"

import {
  "mizchi/bit_core@0.50.0",
  "mizchi/bit_io@0.50.0",
  "mizchi/bit_lib@0.50.0",
  "mizchi/bit_object@0.50.0",
