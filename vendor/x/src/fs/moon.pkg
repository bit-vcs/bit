import {
  "moonbitlang/core/async/types",
  "mizchi/x/data",
  "moonbitlang/core/debug",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs" @async_fs,
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/js_async",
}

warnings = "-0029-0014-0067"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async/types",
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/io",
    "moonbitlang/core/async/js_async",
  ],
  targets: {
    "fs_js.mbt": [ "js" ],
    "fs_fd_native.mbt": [ "native" ],
    "fs_fd_wasm.mbt": [ "wasm" ],
    "fs_native.mbt": [ "native", "wasm" ],
    "fs_native_test.mbt": [ "native" ],
    "fs_test.mbt": [ "native", "js" ],
    "fs_watch_test.mbt": [ "native", "js" ],
    "fs_watcher_native.mbt": [ "native" ],
    "fs_watcher_wasm.mbt": [ "wasm" ],
    "fs_wasmgc.mbt": [ "wasm-gc" ],
  },
)
