import {
  "mizchi/x/data",
  "mizchi/x/gzip",
  "mizchi/x/socket" @x_socket,
  "moonbitlang/core/async",
  "moonbitlang/core/async/http" @async_http,
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/async/tls",
  "moonbitlang/core/bench",
  "moonbitlang/core/cmp",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

warnings = "-0029-0014-0001-0009-0067"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/io",
    "moonbitlang/core/async/js_async",
    "moonbitlang/core/async/socket",
    "moonbitlang/core/async/tls",
  ],
  targets: {
    "http_bench_wbtest.mbt": [ "native", "js" ],
    "http_js.mbt": [ "js" ],
    "http_js_only_test.mbt": [ "js" ],
    "http_js_test.mbt": [ "native", "js" ],
    "http_native.mbt": [ "native", "wasm" ],
    "http_native_test.mbt": [ "native" ],
    "http_native_wbtest.mbt": [ "native" ],
    "http_upstream_test.mbt": [ "native", "js" ],
    "http_wasm.mbt": [ "not", "native", "js", "wasm", "wasm-gc" ],
    "http_wasmgc.mbt": [ "wasm-gc" ],
  },
)
