import {
  "moonbitlang/core/async/types",
  "mizchi/x/data",
  "moonbitlang/core/async/process" @async_process,
  "moonbitlang/core/async/stdio" @async_stdio,
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/js_async",
  "mizchi/x/process",
}

import {
  "moonbitlang/core/async",
  "mizchi/x/fs",
} for "test"

warnings = "-0029-0014"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async/types",
    "moonbitlang/core/async/process",
    "moonbitlang/core/async",
    "moonbitlang/core/async/io",
    "moonbitlang/core/async/js_async",
    "moonbitlang/core/async/stdio",
  ],
  targets: {
    "stdio_js.mbt": [ "js" ],
    "stdio_js_test.mbt": [ "js" ],
    "stdio_native.mbt": [ "native", "wasm" ],
    "stdio_fd_native.mbt": [ "native" ],
    "stdio_fd_wasm.mbt": [ "wasm" ],
    "stdio_native_test.mbt": [ "native" ],
    "stdio_test.mbt": [ "native", "js" ],
    "stdio_wasmgc.mbt": [ "wasm-gc" ],
  },
)
